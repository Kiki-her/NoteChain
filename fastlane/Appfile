# fastlane/Appfile
# App Store Connect アプリ識別情報
# 実際の値に置き換えてから使用してください
#
# 取得方法:
#   app_identifier: App Store Connect > マイ App > 情報 > バンドル ID
#   apple_id:       Apple Developer アカウントのメールアドレス
#   team_id:        developer.apple.com > Account > メンバーシップ > Team ID (10桁英数字)
#
# セキュリティ注意: このファイルは Git に含める（機密情報ではない）
# 機密情報（パスワード・API Key）はすべて環境変数または Keychain で管理すること

# ──────────────────────────────────────────────────────────────
# アプリ識別子
# ──────────────────────────────────────────────────────────────

# App Store Connect のバンドル ID
app_identifier "com.yourcompany.notechain"  # 要変更: 実際のバンドル ID に置き換える

# ──────────────────────────────────────────────────────────────
# Apple アカウント
# ──────────────────────────────────────────────────────────────

# Apple Developer / App Store Connect のメールアドレス
apple_id "your_apple_id@example.com"  # 要変更: 実際の Apple ID に置き換える

# ──────────────────────────────────────────────────────────────
# チーム ID（複数チームに所属する場合に必要）
# ──────────────────────────────────────────────────────────────

# Apple Developer Program の Team ID（10桁英数字）
team_id "XXXXXXXXXX"  # 要変更: 実際の Team ID に置き換える（例: "A1B2C3D4E5"）

# ──────────────────────────────────────────────────────────────
# App Store Connect チーム ID（Fastlane が自動検出できない場合に設定）
# ──────────────────────────────────────────────────────────────
# itc_team_id "123456789"  # 必要な場合はコメント解除して数字 ID を設定
